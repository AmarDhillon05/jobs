# ---------------------------------------------------------------------------
# Internship Job Monitor - example configuration
#
# Copy to `.env` and edit. NEVER commit a real `.env`.
# Every value below is a placeholder; the automated test suite supplies its own
# fake values and never reads this file.
# ---------------------------------------------------------------------------

# --- AWS wiring -------------------------------------------------------------
# Region used by the deployed stack and by LocalStack.
AWS_REGION=us-east-1

# For LOCAL runs only. LocalStack accepts any non-empty credential pair.
# Leave these unset when deploying for real (use an AWS profile / role instead).
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Set to point boto3 at LocalStack. Unset/empty => real AWS endpoints.
AWS_ENDPOINT_URL=http://localhost:4566

# --- Resource names ---------------------------------------------------------
JOBS_TABLE_NAME=jobmonitor-jobs
HEALTH_TABLE_NAME=jobmonitor-scraper-health
DEVICES_TABLE_NAME=jobmonitor-devices
SCRAPE_QUEUE_URL=
SCRAPE_DLQ_URL=
NOTIFICATION_TOPIC_ARN=
NOTIFICATION_QUEUE_URL=
NOTIFICATION_DLQ_URL=

# --- Polling / filtering ----------------------------------------------------
POLL_INTERVAL_MINUTES=10
# Companies per SQS message (coordinator shard size).
SHARD_SIZE=8
# 0-100. Jobs scoring below this are stored but never notified.
NOTIFY_RELEVANCE_THRESHOLD=55
# 0-100. Jobs scoring below this are dropped entirely.
KEEP_RELEVANCE_THRESHOLD=35
# Company priorities that get an immediate (non-batched) alert.
IMMEDIATE_ALERT_PRIORITIES=high

# --- HTTP client ------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_ATTEMPTS=3
HTTP_BACKOFF_BASE_SECONDS=0.5
HTTP_BACKOFF_MAX_SECONDS=20
HTTP_USER_AGENT=internship-job-monitor/0.1 (+personal job alerting; contact: you@example.com)

# --- Email transport --------------------------------------------------------
# One of: ses | console | memory   (tests always use `memory`)
EMAIL_TRANSPORT=console
EMAIL_FROM=alerts@example.com
EMAIL_TO=you@example.com
# Only used when EMAIL_TRANSPORT=ses
SES_CONFIGURATION_SET=
# digest (default): one email per hour listing everything first seen that hour,
#   and no email at all for an hour that found nothing. Instant alerts go to push.
# instant: every alert is also emailed as it happens.
EMAIL_MODE=digest
EMAIL_DIGEST_MINUTES=60

# --- Posting-age window ------------------------------------------------------
# Only postings from the last this-many hours are ever seen; anything older is
# dropped before relevance scoring. 0 or "off" disables the window.
MAX_POSTING_AGE_HOURS=24
# Postings whose source gives no date (Rippling's list, some Workday tenants)
# cannot be shown to be old, so they are kept by default and the seen-before
# check stops them alerting twice. Set to false to drop them instead.
KEEP_UNDATED_POSTINGS=true

# --- Location -----------------------------------------------------------------
# Only postings in the US are scored, stored and alerted on. A posting listing
# several offices is kept if any is in the US. Set US_ONLY=false to see everything.
US_ONLY=true
# Postings whose location says nothing ("Remote", "3 Locations", blank) are kept
# by default; false drops them too.
KEEP_UNKNOWN_LOCATIONS=true

# --- Push transport ---------------------------------------------------------
# One of: ntfy | expo | sns | webpush | console | memory  (tests use `memory`)
# Recommended: `ntfy` - install the free ntfy app, subscribe to your topic, and
# each new job arrives with "Open application" and "Copy link" buttons.
# Use `expo` to alert the React Native app in mobile/ - see mobile/README.md.
PUSH_TRANSPORT=console

# ntfy (PUSH_TRANSPORT=ntfy). Anyone who knows the topic name can read it, so
# make it long and random (e.g. `python -c "import secrets;print('jobs-'+secrets.token_hex(12))"`).
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# Only for a protected topic / self-hosted server with auth.
NTFY_TOKEN=

# Expo push (PUSH_TRANSPORT=expo). Needs no key for a normal project; set the
# access token only if you switched on Expo's "enhanced security for push
# notifications", and then treat it as a secret (SSM/Secrets Manager).
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=

# Web Push (VAPID). Generate with `python scripts/gen_vapid_keys.py`.
# The PRIVATE key is a secret: in production store it in SSM/Secrets Manager.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- API -------------------------------------------------------------------
# Shared token for the write endpoints (POST /devices/register only). Read
# endpoints need none. `make serve-api` falls back to "local-dev-token", which is
# what mobile/app.json ships with, so the phone app works against a local API out
# of the box. Change both for anything reachable from the internet, and store the
# deployed value in SSM/Secrets Manager.
API_WRITE_TOKEN=local-dev-token

# --- Client / deep links ----------------------------------------------------
# Base URL the notification deep links point at. The web client (web/) for a
# browser; for the Expo app either this https URL or internshipmonitor:// works.
APP_BASE_URL=http://localhost:5173
# Base URL of the jobs API both clients read.
API_BASE_URL=http://localhost:8000

# --- Apply kit (optional) --------------------------------------------------
# Kit links in alerts need both: the API's base URL and the link-signing secret.
# Deployed, the stack sets KIT_BASE_URL itself and reads the secret from SSM
# (/jobmonitor/kit-secret, created by `make apply-setup`); never put it here.
KIT_BASE_URL=
KIT_SECRET=
# Local kit preview (`python -m jobmonitor.api.local_server --seed`): your profile
# (default: apply/profile.json if present, else the example) and resume. Drafts
# use a sample drafter unless ANTHROPIC_API_KEY and APPLY_RESUME are both set. The key is a secret:
# deployed, it lives in SSM (/jobmonitor/anthropic-api-key).
APPLY_PROFILE=
APPLY_RESUME=
ANTHROPIC_API_KEY=

# --- Live validation (opt-in) ----------------------------------------------
# Set to 1 to allow `-m live` tests to contact real public careers endpoints.
ENABLE_LIVE_TESTS=0
